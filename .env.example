# Application
APP_ENV=development
DEBUG=true

# PostgreSQL
DATABASE_URL=postgresql://postgres:password@localhost:5432/elibrary
TEST_DATABASE_URL=postgresql://postgres:password@localhost:5432/elibrary_test

# Authentication
JWT_SECRET_KEY=change-me-to-a-long-random-secret
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Userfacet AI (use an assigned token only in your local .env file)
AI_API_BASE_URL=https://ai-api.userfacet.com
AI_API_TOKEN=your-assigned-token
AI_API_TIMEOUT_SECONDS=15
AI_SUMMARY_MAX_SOURCE_CHARS=12000
AI_SUMMARY_RATE_LIMIT=10/hour

# Catalog bulk creation
CATALOG_BULK_MAX_ITEMS=50

# Comma-separated origins allowed to call the API from a browser
CORS_ORIGINS=http://localhost:3000
